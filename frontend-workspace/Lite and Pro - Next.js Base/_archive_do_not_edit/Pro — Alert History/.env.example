# Local FastAPI backend from CONTRACT.md
NEXT_PUBLIC_HAZE_API_BASE_URL=http://localhost:8000/api/v1

# api | mock
# mock keeps the demo recordable without a network dependency.
NEXT_PUBLIC_HAZE_DATA_MODE=mock

# Optional. If blank, the UI picks the first school/hospital returned by /institutions.
NEXT_PUBLIC_HAZE_INSTITUTION_ID=
