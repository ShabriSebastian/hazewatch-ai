# Local FastAPI backend from CONTRACT.md
NEXT_PUBLIC_HAZE_API_BASE_URL=http://localhost:8000/api/v1

# api | mock
# api is the wired default. mock keeps the demo recordable without a network
# dependency and is the fallback if the backend is unreachable.
NEXT_PUBLIC_HAZE_DATA_MODE=api

# Optional starting institution. If blank, the UI picks the first school/hospital
# returned by /institutions. The selector in the header overrides it either way.
NEXT_PUBLIC_HAZE_INSTITUTION_ID=
