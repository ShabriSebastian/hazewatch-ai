# The published live snapshot - the dashboard's only data source.
#
# There is no backend. The API and the Sept 2023 replay it served were retired;
# see DEVELOPMENT.md. Without this value the app has no data and every screen
# renders an explicit "no data to show" state rather than a blank page.
#
# For local work, generate one and serve it from the app itself:
#
#   python scripts/07_live_snapshot.py --out frontend/public/dev-snapshot.json
#   echo 'NEXT_PUBLIC_HAZE_SNAPSHOT_URL=/dev-snapshot.json' > frontend/.env.local
#
NEXT_PUBLIC_HAZE_SNAPSHOT_URL=

# The accumulated alert history. Optional: when unset it is derived from the
# snapshot URL by swapping the filename (latest.json -> history.json,
# dev-snapshot.json -> dev-history.json). A missing history is not fatal -
# Alert History says it has a single observation rather than failing.
NEXT_PUBLIC_HAZE_HISTORY_URL=

# Optional starting institutions. If blank, the UI picks the first addressable
# one from the snapshot. The header selector overrides both either way.
NEXT_PUBLIC_HAZE_INSTITUTION_ID=
NEXT_PUBLIC_HAZE_PRO_INSTITUTION_ID=
