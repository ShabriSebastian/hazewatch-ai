# Local FastAPI backend from CONTRACT.md
NEXT_PUBLIC_HAZE_API_BASE_URL=http://localhost:8000/api/v1

# api | mock
# api is the wired default. mock keeps the demo recordable without a network
# dependency and is the fallback if the backend is unreachable.
NEXT_PUBLIC_HAZE_DATA_MODE=api

# Optional starting institutions. If blank, the UI picks from /institutions.
# The header selector overrides both either way.
NEXT_PUBLIC_HAZE_INSTITUTION_ID=
NEXT_PUBLIC_HAZE_PRO_INSTITUTION_ID=

# Scheduled live snapshot, published as a static file by GitHub Actions.
# Leave blank to disable the panel entirely (it renders nothing without this).
NEXT_PUBLIC_HAZE_SNAPSHOT_URL=
